# Salin file ini ke .env untuk pengembangan lokal (jangan commit .env).
# Untuk production: set Environment Variables di Vercel (Settings > Environment Variables).

# Provider AI (minimal salah satu terisi):
# 1) Google Gemini — dipakai duluan bila ada (model gratis: gemini-2.5-flash)
GOOGLE_API_KEY=AIza-xxxxxxxx
# 2) OpenRouter — fallback (model :free allowlist di api/ai.js)
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Opsional: paksa model (harus ada di allowlist api/ai.js)
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Ingatan antar-sesi (fitur AI) ---
# Password utk mengaktifkan fitur ingatan (satu password staf)
MEMORY_PASSWORD=ganti-password-ini
# Produksi: Vercel KV (Upstash) — isi otomatis oleh integrasi KV:
# UPSTASH_REDIS_REST_URL=...
# UPSTASH_REDIS_REST_TOKEN=...
# Dev lokal tanpa KV: cukup set MEM_LOCAL_FILE (file JSON; jangan dipakai produksi)
# MEM_LOCAL_FILE=X:/jadwalguruabbs/.mem-dev.json
